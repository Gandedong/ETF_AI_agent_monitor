# OpenRouter 设置
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=ETF Agent Monitor


# 邮件提醒（SMTP）；开启后会在规则触发时发送邮件
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_FROM=ETF Agent Monitor <your_email@example.com>
EMAIL_TO=recipient@example.com
EMAIL_ALERT_LEVELS=info,warning,danger
EMAIL_SUBJECT_PREFIX=ETF盯盘提醒

# SQLite 数据库路径
DATABASE_PATH=./data/etf_monitor.db

# 定时任务：A股交易日盘中检查
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_HOURS=10,14
SCHEDULER_MINUTE=30

# 是否在首页显示调试信息
DEBUG=false
